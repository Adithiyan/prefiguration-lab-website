		<div id="emergency-banner">
			
			
			<div id="emergency-banner-collapsed" class="text-white d-none">
				<div class="d-flex align-items-center">
					<div>
						<img class="m-2" height="20" src="data:image/png;base64," alt="alert icon">
					</div>
